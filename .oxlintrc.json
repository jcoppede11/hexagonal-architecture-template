{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "error",
        "suspicious": "warn"
    },
    "rules": {
        "typescript/no-extraneous-class": ["error", { "allowWithDecorator": true }]
    },
    "ignorePatterns": ["dist", "node_modules"]
}
